<UserControl x:Class="TaskTracker2.Views.Controls.TaskListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="TaskCardTemplate">
            <Border x:Name="CardBorder"
                    CornerRadius="10"
                    Padding="14,11"
                    Margin="0,0,0,7"
                    Cursor="Hand"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    MouseLeftButtonUp="TaskCard_MouseLeftButtonUp">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Completion Checkbox -->
                    <CheckBox Grid.Column="0"
                              IsChecked="{Binding IsComplete, Mode=TwoWay}"
                              VerticalAlignment="Center"
                              Margin="0,0,10,0"
                              PreviewMouseLeftButtonUp="TaskCheckBox_PreviewMouseLeftButtonUp"
                              Click="TaskCheckBox_Click" />

                    <!-- Title & Metadata Chips -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}"
                                   FontSize="14"
                                   FontWeight="Medium"
                                   TextTrimming="CharacterEllipsis"
                                   TextDecorations="{Binding IsComplete, Converter={StaticResource BoolToTextDecorationsConverter}}"
                                   Opacity="{Binding IsComplete, Converter={StaticResource BoolToOpacityConverter}}"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                        <WrapPanel Margin="0,5,0,0" Orientation="Horizontal">
                            <!-- Due Date Chip -->
                            <Border CornerRadius="6"
                                    Padding="7,2"
                                    Margin="0,0,6,0"
                                    Visibility="{Binding HasDueDate, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDueToday}" Value="True">
                                                <Setter Property="Background" Value="#243B82F6" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                <Setter Property="Background" Value="#2CEF4444" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="CalendarLtr16" FontSize="12" Margin="0,0,4,0">
                                        <ui:SymbolIcon.Style>
                                            <Style TargetType="ui:SymbolIcon">
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDueToday}" Value="True">
                                                        <Setter Property="Foreground" Value="#3B82F6" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                        <Setter Property="Foreground" Value="#EF4444" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:SymbolIcon.Style>
                                    </ui:SymbolIcon>
                                    <TextBlock Text="{Binding DueDateDisplay}" FontSize="11.5" FontWeight="Medium">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDueToday}" Value="True">
                                                        <Setter Property="Foreground" Value="#3B82F6" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                        <Setter Property="Foreground" Value="#EF4444" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Priority Pill -->
                            <Border CornerRadius="6"
                                    Padding="7,2"
                                    Margin="0,0,6,0"
                                    Background="{Binding Priority, Converter={StaticResource PriorityToSoftBrushConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Margin="0,0,5,0"
                                             Fill="{Binding Priority, Converter={StaticResource PriorityToBrushConverter}}" />
                                    <TextBlock Text="{Binding Priority, Converter={StaticResource PriorityToLabelConverter}}"
                                               FontSize="11.5"
                                               FontWeight="Medium"
                                               Foreground="{Binding Priority, Converter={StaticResource PriorityToBrushConverter}}" />
                                </StackPanel>
                            </Border>

                            <!-- Custom List Tag -->
                            <Border CornerRadius="6"
                                    Padding="7,2"
                                    Margin="0,0,6,0"
                                    Background="{Binding ListColorHex, Converter={StaticResource HexToBrushConverter}, ConverterParameter=28}"
                                    Visibility="{Binding HasList, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Margin="0,0,5,0"
                                             Fill="{Binding ListColorHex, Converter={StaticResource HexToBrushConverter}}" />
                                    <TextBlock Text="{Binding ListName}"
                                               FontSize="11.5"
                                               FontWeight="Medium"
                                               Foreground="{Binding ListColorHex, Converter={StaticResource HexToBrushConverter}}" />
                                </StackPanel>
                            </Border>

                            <!-- Subtask Progress -->
                            <Border CornerRadius="6"
                                    Padding="7,2"
                                    Margin="0,0,6,0"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    Visibility="{Binding HasSubtasks, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="CheckboxChecked16" FontSize="12" Margin="0,0,4,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding SubtaskSummary}"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- Notes Indicator -->
                            <ui:SymbolIcon Symbol="Note16"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           Margin="2,0,0,0"
                                           ToolTip="Has notes"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Visibility="{Binding HasNotes, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </WrapPanel>
                    </StackPanel>

                    <!-- Hover Quick Delete -->
                    <ui:Button x:Name="DeleteRowButton"
                               Grid.Column="2"
                               Appearance="Transparent"
                               Padding="6"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Opacity="0"
                               ToolTip="Delete task (Del)"
                               Click="DeleteTaskButton_Click">
                        <ui:SymbolIcon Symbol="Delete20" FontSize="15"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </ui:Button>
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <Trigger SourceName="CardBorder" Property="IsMouseOver" Value="True">
                    <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                    <Setter TargetName="DeleteRowButton" Property="Opacity" Value="0.85" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                    <Setter TargetName="CardBorder" Property="BorderThickness" Value="1.5" />
                    <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="24,8,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header Bar: Title + Search + Sort -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="4"
                        Height="34"
                        CornerRadius="2"
                        Margin="0,0,12,0"
                        Background="{Binding ViewAccentHex, Converter={StaticResource HexToBrushConverter}}" />
                <StackPanel>
                    <TextBlock Text="{Binding ViewTitle}"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="{Binding ViewSubtitle}"
                               FontSize="12.5"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,1,0,0" />
                </StackPanel>
            </StackPanel>

            <!-- Search Box -->
            <ui:TextBox x:Name="SearchTextBox"
                        Grid.Column="1"
                        Width="210"
                        VerticalAlignment="Center"
                        Margin="12,0,8,0"
                        PlaceholderText="Search tasks... (Ctrl+F)"
                        Icon="{ui:SymbolIcon Search24}"
                        ClearButtonEnabled="True"
                        Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" />

            <!-- Sort Selector -->
            <ComboBox Grid.Column="2"
                      Width="148"
                      VerticalAlignment="Center"
                      ToolTip="Sort tasks by"
                      ItemsSource="{Binding SortOptions}"
                      SelectedItem="{Binding SelectedSortOption}"
                      DisplayMemberPath="Label" />
        </Grid>

        <!-- Quick-Add Card -->
        <Border Grid.Row="1"
                CornerRadius="12"
                Padding="14,10"
                Margin="0,0,0,16"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Visibility="{Binding IsQuickAddVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Primary Input Row -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:TextBox x:Name="QuickAddTextBox"
                                Grid.Column="0"
                                PlaceholderText="Add a task... (Ctrl+N, Enter to save)"
                                Icon="{ui:SymbolIcon Add24}"
                                Text="{Binding QuickAddTitle, UpdateSourceTrigger=PropertyChanged}"
                                KeyDown="QuickAddTextBox_KeyDown" />

                    <ui:Button Grid.Column="1"
                               Content="Add"
                               Appearance="Primary"
                               Margin="8,0,0,0"
                               Padding="16,0"
                               Command="{Binding AddTaskCommand}" />
                </Grid>

                <!-- Quick Metadata Controls -->
                <WrapPanel Grid.Row="1" Margin="0,9,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Quick Due Date Picker -->
                    <DatePicker Width="130"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                ToolTip="Due date"
                                SelectedDate="{Binding QuickAddDueDate, Converter={StaticResource DateOnlyToDateTimeConverter}, Mode=TwoWay}" />

                    <ui:Button Content="Today"
                               Appearance="Secondary"
                               Padding="9,4"
                               FontSize="12"
                               Margin="0,0,4,0"
                               Command="{Binding SetQuickAddDueTodayCommand}" />

                    <ui:Button Content="Tomorrow"
                               Appearance="Secondary"
                               Padding="9,4"
                               FontSize="12"
                               Margin="0,0,4,0"
                               Command="{Binding SetQuickAddDueTomorrowCommand}" />

                    <ui:Button Appearance="Transparent"
                               Padding="6,4"
                               Margin="0,0,10,0"
                               ToolTip="Clear due date"
                               Visibility="{Binding QuickAddDueDate, Converter={StaticResource NotNullToVisibilityConverter}}"
                               Command="{Binding ClearQuickAddDueDateCommand}">
                        <ui:SymbolIcon Symbol="Dismiss16" FontSize="12" />
                    </ui:Button>

                    <!-- Priority Cycler Pill -->
                    <ui:Button Appearance="Secondary"
                               Padding="10,4"
                               Margin="0,0,8,0"
                               ToolTip="Click to cycle priority (Low / Normal / High)"
                               Command="{Binding CycleQuickAddPriorityCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Margin="0,0,6,0"
                                     Fill="{Binding QuickAddPriority, Converter={StaticResource PriorityToBrushConverter}}" />
                            <TextBlock Text="{Binding QuickAddPriority, Converter={StaticResource PriorityToLabelConverter}}"
                                       FontSize="12"
                                       FontWeight="Medium" />
                        </StackPanel>
                    </ui:Button>

                    <!-- List Selector -->
                    <ComboBox MinWidth="128"
                              Height="30"
                              VerticalAlignment="Center"
                              ToolTip="Assign to list"
                              ItemsSource="{Binding QuickAddListOptions}"
                              SelectedItem="{Binding QuickAddListOption}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Margin="0,0,7,0"
                                             Fill="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}" />
                                    <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Task Lists + Empty State -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,4,16">
                <!-- Empty State -->
                <Border CornerRadius="14"
                        Padding="32,48"
                        Margin="0,12,0,0"
                        Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Visibility="{Binding IsCurrentViewEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="52" Height="52" CornerRadius="26"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,14"
                                Background="{Binding ViewAccentHex, Converter={StaticResource HexToBrushConverter}, ConverterParameter=30}">
                            <ui:SymbolIcon Symbol="CheckmarkCircle24"
                                           FontSize="26"
                                           Foreground="{Binding ViewAccentHex, Converter={StaticResource HexToBrushConverter}}" />
                        </Border>
                        <TextBlock Text="{Binding EmptyStateTitle}"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{Binding EmptyStateSubtitle}"
                                   FontSize="13"
                                   Margin="0,6,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Active Tasks -->
                <ItemsControl ItemsSource="{Binding ActiveTasks}"
                              ItemTemplate="{StaticResource TaskCardTemplate}" />

                <!-- Completed View Direct List (when Completed SmartView is selected) -->
                <ItemsControl ItemsSource="{Binding CompletedTasks}"
                              ItemTemplate="{StaticResource TaskCardTemplate}"
                              Visibility="{Binding IsCompletedSelected, Converter={StaticResource BoolToVisibilityConverter}}" />

                <!-- Collapsible Completed Section (in non-Completed views) -->
                <StackPanel Margin="0,12,0,0"
                            Visibility="{Binding ShowSplitCompletedSection, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ui:Button Appearance="Transparent"
                               Padding="8,5"
                               Margin="0,0,0,8"
                               HorizontalAlignment="Left"
                               Command="{Binding ToggleCompletedSectionCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon FontSize="13" Margin="0,0,6,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Symbol" Value="ChevronRight16" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCompletedSectionExpanded}" Value="True">
                                                <Setter Property="Symbol" Value="ChevronDown16" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                            <TextBlock Text="Completed"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Border CornerRadius="8"
                                    Padding="6,1"
                                    Margin="7,0,0,0"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                <TextBlock Text="{Binding CompletedTasks.Count}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </StackPanel>
                    </ui:Button>

                    <ItemsControl ItemsSource="{Binding CompletedTasks}"
                                  ItemTemplate="{StaticResource TaskCardTemplate}"
                                  Visibility="{Binding IsCompletedSectionExpanded, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
