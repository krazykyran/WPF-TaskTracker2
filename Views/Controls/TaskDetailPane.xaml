<UserControl x:Class="TaskTracker2.Views.Controls.TaskDetailPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:models="clr-namespace:TaskTracker2.Models"
             HorizontalAlignment="Stretch">
    <UserControl.Resources>
        <Style x:Key="PrioritySegmentStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SegmentBorder"
                                CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SegmentBorder" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="True">
                                <Setter TargetName="SegmentBorder" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                <Setter TargetName="SegmentBorder" Property="BorderThickness" Value="1.5" />
                                <Setter TargetName="SegmentBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1,0,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Header -->
            <Grid Grid.Row="0" Margin="18,10,12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Task Details"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ui:Button Grid.Column="1"
                           Appearance="Transparent"
                           Padding="7"
                           ToolTip="Collapse details panel (Esc)"
                           Click="CloseButton_Click">
                    <ui:SymbolIcon Symbol="PanelRightContract20"
                                   FontSize="17"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </ui:Button>
            </Grid>

            <!-- Scrollable Editor Body -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="18,4,18,16">
                <StackPanel DataContext="{Binding Detail}">
                    <!-- Title + Complete -->
                    <Border CornerRadius="10"
                            Padding="12,10"
                            Margin="0,0,0,14"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0"
                                      IsChecked="{Binding IsComplete, Mode=TwoWay}"
                                      VerticalAlignment="Top"
                                      Margin="0,6,8,0" />
                            <ui:TextBox Grid.Column="1"
                                        Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                        TextWrapping="Wrap"
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        PlaceholderText="Task title"
                                        ClearButtonEnabled="False" />
                        </Grid>
                    </Border>

                    <!-- Priority -->
                    <TextBlock Text="Priority"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="2,0,0,6" />
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Style="{StaticResource PrioritySegmentStyle}"
                                Tag="{Binding Priority, Converter={StaticResource PriorityEqualsConverter}, ConverterParameter=Low}"
                                Command="{Binding SetPriorityCommand}"
                                CommandParameter="{x:Static models:TaskPriority.Low}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="#64748B" Margin="0,0,6,0" />
                                <TextBlock Text="Low" FontSize="12.5" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2"
                                Style="{StaticResource PrioritySegmentStyle}"
                                Tag="{Binding Priority, Converter={StaticResource PriorityEqualsConverter}, ConverterParameter=Normal}"
                                Command="{Binding SetPriorityCommand}"
                                CommandParameter="{x:Static models:TaskPriority.Normal}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="#3B82F6" Margin="0,0,6,0" />
                                <TextBlock Text="Normal" FontSize="12.5" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="4"
                                Style="{StaticResource PrioritySegmentStyle}"
                                Tag="{Binding Priority, Converter={StaticResource PriorityEqualsConverter}, ConverterParameter=High}"
                                Command="{Binding SetPriorityCommand}"
                                CommandParameter="{x:Static models:TaskPriority.High}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="#EF4444" Margin="0,0,6,0" />
                                <TextBlock Text="High" FontSize="12.5" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Due Date -->
                    <TextBlock Text="Due Date"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="2,0,0,6" />
                    <DatePicker Margin="0,0,0,8"
                                SelectedDate="{Binding DueDate, Converter={StaticResource DateOnlyToDateTimeConverter}, Mode=TwoWay}" />
                    <WrapPanel Margin="0,0,0,16">
                        <ui:Button Content="Today"
                                   Appearance="Secondary"
                                   Padding="10,4"
                                   FontSize="12"
                                   Margin="0,0,6,6"
                                   Command="{Binding SetDueTodayCommand}" />
                        <ui:Button Content="Tomorrow"
                                   Appearance="Secondary"
                                   Padding="10,4"
                                   FontSize="12"
                                   Margin="0,0,6,6"
                                   Command="{Binding SetDueTomorrowCommand}" />
                        <ui:Button Content="Next Week"
                                   Appearance="Secondary"
                                   Padding="10,4"
                                   FontSize="12"
                                   Margin="0,0,6,6"
                                   Command="{Binding SetDueNextWeekCommand}" />
                        <ui:Button Content="Clear"
                                   Appearance="Transparent"
                                   Padding="8,4"
                                   FontSize="12"
                                   Margin="0,0,0,6"
                                   Visibility="{Binding DueDate, Converter={StaticResource NotNullToVisibilityConverter}}"
                                   Command="{Binding ClearDueDateCommand}" />
                    </WrapPanel>

                    <!-- List Assignment -->
                    <TextBlock Text="List"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="2,0,0,6" />
                    <ComboBox Margin="0,0,0,16"
                              ItemsSource="{Binding ListOptions}"
                              SelectedItem="{Binding SelectedListOption, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Margin="0,0,8,0"
                                             Fill="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Subtasks Checklist -->
                    <TextBlock Text="Subtasks"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="2,0,0,6" />
                    <Border CornerRadius="10"
                            Padding="10,8"
                            Margin="0,0,0,16"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Subtasks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding IsComplete, Mode=TwoWay}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,6,0"
                                                      Click="SubtaskCheckBox_Click" />

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Title}"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center"
                                                       FontSize="13"
                                                       TextDecorations="{Binding IsComplete, Converter={StaticResource BoolToTextDecorationsConverter}}"
                                                       Opacity="{Binding IsComplete, Converter={StaticResource BoolToOpacityConverter}}"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                                            <ui:Button Grid.Column="2"
                                                       Appearance="Transparent"
                                                       Padding="4"
                                                       ToolTip="Remove subtask"
                                                       Click="DeleteSubtaskButton_Click">
                                                <ui:SymbolIcon Symbol="Dismiss16" FontSize="12"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            </ui:Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Add Subtask Input -->
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Grid.Column="0"
                                            PlaceholderText="Add a step..."
                                            FontSize="13"
                                            Text="{Binding NewSubtaskTitle, UpdateSourceTrigger=PropertyChanged}"
                                            KeyDown="NewSubtaskTextBox_KeyDown" />
                                <ui:Button Grid.Column="1"
                                           Appearance="Secondary"
                                           Padding="8,0"
                                           Margin="6,0,0,0"
                                           ToolTip="Add subtask"
                                           Command="{Binding AddSubtaskCommand}">
                                    <ui:SymbolIcon Symbol="Add16" FontSize="14" />
                                </ui:Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Notes -->
                    <TextBlock Text="Notes"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="2,0,0,6" />
                    <ui:TextBox AcceptsReturn="True"
                                TextWrapping="Wrap"
                                MinHeight="110"
                                VerticalContentAlignment="Top"
                                PlaceholderText="Add details, links, or reminders..."
                                Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </ScrollViewer>

            <!-- Footer: Created Date + Delete -->
            <Border Grid.Row="2"
                    Padding="18,10"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0"
                    DataContext="{Binding Detail}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding CreatedAtDisplay}"
                               FontSize="11.5"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <ui:Button Grid.Column="1"
                               Appearance="Transparent"
                               Padding="8,5"
                               ToolTip="Delete task"
                               Command="{Binding DeleteCurrentTaskCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Delete20" FontSize="14" Foreground="#EF4444" Margin="0,0,5,0" />
                            <TextBlock Text="Delete" FontSize="12" Foreground="#EF4444" />
                        </StackPanel>
                    </ui:Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
