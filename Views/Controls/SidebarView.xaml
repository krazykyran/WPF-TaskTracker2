<UserControl x:Class="TaskTracker2.Views.Controls.SidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:models="clr-namespace:TaskTracker2.Models">
    <UserControl.Resources>
        <Style x:Key="SidebarNavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Border x:Name="ActiveIndicator"
                                        Width="3"
                                        Height="16"
                                        CornerRadius="2"
                                        HorizontalAlignment="Left"
                                        Margin="-10,0,0,0"
                                        Background="{DynamicResource SystemAccentColorPrimaryBrush}"
                                        Visibility="Collapsed" />
                                <ContentPresenter HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Visible" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CountBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="7,1" />
            <Setter Property="MinWidth" Value="22" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="ThemePillButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PillBorder"
                                CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,1,0"
            Padding="12,6,12,14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Brand Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,2,8,14" VerticalAlignment="Center">
                <Border Width="28" Height="28" CornerRadius="8"
                        Background="{DynamicResource SystemAccentColorPrimaryBrush}">
                    <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="16" Foreground="White" />
                </Border>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="TaskTracker"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
            </StackPanel>

            <!-- Scrollable Nav -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- Smart Views -->
                    <Button Style="{StaticResource SidebarNavButtonStyle}"
                            Tag="{Binding IsTodaySelected}"
                            Command="{Binding SelectSmartViewCommand}"
                            CommandParameter="{x:Static models:SmartViewType.Today}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="WeatherSunny24" FontSize="17"
                                           Foreground="#3B82F6" Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1" Text="Today" VerticalAlignment="Center" FontSize="13.5" />
                            <Border Grid.Column="2"
                                    CornerRadius="10"
                                    Padding="6,1"
                                    Margin="0,0,4,0"
                                    VerticalAlignment="Center"
                                    Background="#30EF4444"
                                    ToolTip="Overdue tasks"
                                    Visibility="{Binding OverdueCount, Converter={StaticResource CountToVisibilityConverter}}">
                                <TextBlock Text="{Binding OverdueCount}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#EF4444" />
                            </Border>
                            <Border Grid.Column="3" Style="{StaticResource CountBadgeStyle}"
                                    Visibility="{Binding TodayCount, Converter={StaticResource CountToVisibilityConverter}}">
                                <TextBlock Text="{Binding TodayCount}" FontSize="11.5" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource SidebarNavButtonStyle}"
                            Tag="{Binding IsUpcomingSelected}"
                            Command="{Binding SelectSmartViewCommand}"
                            CommandParameter="{x:Static models:SmartViewType.Upcoming}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="CalendarLtr24" FontSize="17"
                                           Foreground="#8B5CF6" Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1" Text="Upcoming" VerticalAlignment="Center" FontSize="13.5" />
                            <Border Grid.Column="2" Style="{StaticResource CountBadgeStyle}"
                                    Visibility="{Binding UpcomingCount, Converter={StaticResource CountToVisibilityConverter}}">
                                <TextBlock Text="{Binding UpcomingCount}" FontSize="11.5" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource SidebarNavButtonStyle}"
                            Tag="{Binding IsAllSelected}"
                            Command="{Binding SelectSmartViewCommand}"
                            CommandParameter="{x:Static models:SmartViewType.All}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="TaskListSquareLtr24" FontSize="17"
                                           Foreground="#06B6D4" Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1" Text="All Tasks" VerticalAlignment="Center" FontSize="13.5" />
                            <Border Grid.Column="2" Style="{StaticResource CountBadgeStyle}"
                                    Visibility="{Binding AllIncompleteCount, Converter={StaticResource CountToVisibilityConverter}}">
                                <TextBlock Text="{Binding AllIncompleteCount}" FontSize="11.5" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource SidebarNavButtonStyle}"
                            Tag="{Binding IsHighPrioritySelected}"
                            Command="{Binding SelectSmartViewCommand}"
                            CommandParameter="{x:Static models:SmartViewType.HighPriority}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="Flag24" FontSize="17"
                                           Foreground="#EF4444" Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1" Text="High Priority" VerticalAlignment="Center" FontSize="13.5" />
                            <Border Grid.Column="2" Style="{StaticResource CountBadgeStyle}"
                                    Visibility="{Binding HighPriorityCount, Converter={StaticResource CountToVisibilityConverter}}">
                                <TextBlock Text="{Binding HighPriorityCount}" FontSize="11.5" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource SidebarNavButtonStyle}"
                            Tag="{Binding IsCompletedSelected}"
                            Command="{Binding SelectSmartViewCommand}"
                            CommandParameter="{x:Static models:SmartViewType.Completed}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="CheckmarkCircle24" FontSize="17"
                                           Foreground="#10B981" Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1" Text="Completed" VerticalAlignment="Center" FontSize="13.5" />
                            <Border Grid.Column="2" Style="{StaticResource CountBadgeStyle}"
                                    Visibility="{Binding CompletedCount, Converter={StaticResource CountToVisibilityConverter}}">
                                <TextBlock Text="{Binding CompletedCount}" FontSize="11.5" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </Grid>
                    </Button>

                    <!-- Divider -->
                    <Border Height="1"
                            Margin="6,14,6,12"
                            Background="{DynamicResource CardStrokeColorDefaultBrush}" />

                    <!-- Custom Lists Header -->
                    <Grid Margin="10,0,4,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="LISTS"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <ui:Button Grid.Column="1"
                                   Appearance="Transparent"
                                   Padding="6,4"
                                   ToolTip="Create a new list"
                                   Click="AddListButton_Click">
                            <ui:SymbolIcon Symbol="Add16" FontSize="14" />
                        </ui:Button>
                    </Grid>

                    <!-- Custom Lists -->
                    <ItemsControl ItemsSource="{Binding CustomLists}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SidebarNavButtonStyle}"
                                        Tag="{Binding IsSelected}"
                                        Command="{Binding DataContext.SelectCustomListCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Edit List" Click="EditListMenuItem_Click" />
                                            <Separator />
                                            <MenuItem Header="Delete List" Click="DeleteListMenuItem_Click" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Grid.Column="0"
                                                       Symbol="{Binding IconName, Converter={StaticResource SymbolNameConverter}}"
                                                       FontSize="16"
                                                       Foreground="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                       Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   FontSize="13.5" />
                                        <Border Grid.Column="2"
                                                Style="{StaticResource CountBadgeStyle}"
                                                Visibility="{Binding IncompleteCount, Converter={StaticResource CountToVisibilityConverter}}">
                                            <TextBlock Text="{Binding IncompleteCount}"
                                                       FontSize="11.5"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Prompt when no custom lists yet -->
                    <Button Margin="0,4,0,0"
                            Style="{StaticResource SidebarNavButtonStyle}"
                            Click="AddListButton_Click"
                            Visibility="{Binding CustomLists.Count, Converter={StaticResource ZeroCountToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Opacity="0.72">
                            <ui:SymbolIcon Symbol="AddCircle24" FontSize="16" Margin="0,0,10,0" />
                            <TextBlock Text="New List" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>

            <!-- Bottom Theme Switcher -->
            <Border Grid.Row="2"
                    Margin="0,12,0,0"
                    Padding="4"
                    CornerRadius="8"
                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Style="{StaticResource ThemePillButtonStyle}"
                            ToolTip="Match Windows theme"
                            Tag="{Binding ThemePreference, Converter={StaticResource ThemeEqualsConverter}, ConverterParameter=System}"
                            Command="{Binding SetThemeCommand}"
                            CommandParameter="{x:Static models:AppThemePreference.System}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Desktop24" FontSize="13" Margin="0,0,5,0" />
                            <TextBlock Text="Auto" FontSize="11.5" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="1"
                            Style="{StaticResource ThemePillButtonStyle}"
                            ToolTip="Light theme"
                            Tag="{Binding ThemePreference, Converter={StaticResource ThemeEqualsConverter}, ConverterParameter=Light}"
                            Command="{Binding SetThemeCommand}"
                            CommandParameter="{x:Static models:AppThemePreference.Light}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="WeatherSunny24" FontSize="13" Margin="0,0,5,0" />
                            <TextBlock Text="Light" FontSize="11.5" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2"
                            Style="{StaticResource ThemePillButtonStyle}"
                            ToolTip="Dark theme"
                            Tag="{Binding ThemePreference, Converter={StaticResource ThemeEqualsConverter}, ConverterParameter=Dark}"
                            Command="{Binding SetThemeCommand}"
                            CommandParameter="{x:Static models:AppThemePreference.Dark}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="WeatherMoon24" FontSize="13" Margin="0,0,5,0" />
                            <TextBlock Text="Dark" FontSize="11.5" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
