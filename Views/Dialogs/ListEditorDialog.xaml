<ui:FluentWindow x:Class="TaskTracker2.Views.Dialogs.ListEditorDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{Binding DialogTitle}"
                 Width="420"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 ExtendsContentIntoTitleBar="True"
                 ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="{Binding DialogTitle}"
                     Height="36"
                     ShowMaximize="False"
                     ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="22,8,22,22">
            <!-- Preview Banner -->
            <Border CornerRadius="10"
                    Padding="14,12"
                    Margin="0,0,0,16"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="8"
                            Background="{Binding SelectedColorHex, Converter={StaticResource HexToBrushConverter}, ConverterParameter=38}">
                        <ui:SymbolIcon Symbol="{Binding SelectedIconName, Converter={StaticResource SymbolNameConverter}}"
                                       FontSize="18"
                                       Foreground="{Binding SelectedColorHex, Converter={StaticResource HexToBrushConverter}}" />
                    </Border>
                    <TextBlock Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding Name}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Name}" Value="">
                                        <Setter Property="Text" Value="List preview" />
                                        <Setter Property="Opacity" Value="0.5" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Name -->
            <TextBlock Text="List Name"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="0,0,0,6" />
            <ui:TextBox x:Name="NameTextBox"
                        PlaceholderText="e.g., Personal, Work, Errands"
                        Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                        KeyDown="NameTextBox_KeyDown"
                        Margin="0,0,0,16" />

            <!-- Color Swatches -->
            <TextBlock Text="Accent Color"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="0,0,0,8" />
            <ItemsControl ItemsSource="{Binding ColorOptions}" Margin="0,0,0,16">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <RadioButton GroupName="ListColorGroup"
                                     Margin="0,0,8,8"
                                     Cursor="Hand"
                                     ToolTip="{Binding Name}"
                                     Checked="ColorSwatch_Checked"
                                     Tag="{Binding Hex}">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="OuterRing"
                                            Width="32" Height="32"
                                            CornerRadius="16"
                                            Padding="3"
                                            BorderThickness="2"
                                            BorderBrush="Transparent"
                                            Background="Transparent">
                                        <Ellipse Fill="{Binding Hex, Converter={StaticResource HexToBrushConverter}}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="OuterRing" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="OuterRing" Property="Opacity" Value="0.88" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Icon Picker -->
            <TextBlock Text="Icon"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="0,0,0,8" />
            <ItemsControl ItemsSource="{Binding IconOptions}" Margin="0,0,0,20">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <RadioButton GroupName="ListIconGroup"
                                     Margin="0,0,6,6"
                                     Cursor="Hand"
                                     ToolTip="{Binding Label}"
                                     Checked="IconOption_Checked"
                                     Tag="{Binding SymbolName}">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="IconBorder"
                                            Width="34" Height="34"
                                            CornerRadius="8"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="1">
                                        <ui:SymbolIcon Symbol="{Binding SymbolName, Converter={StaticResource SymbolNameConverter}}"
                                                       FontSize="16"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="IconBorder" Property="Background" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                            <Setter TargetName="IconBorder" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="IconBorder" Property="Opacity" Value="0.85" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Actions -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Cancel"
                           Appearance="Secondary"
                           Margin="0,0,8,0"
                           MinWidth="84"
                           Click="CancelButton_Click" />
                <ui:Button Content="{Binding PrimaryButtonText}"
                           Appearance="Primary"
                           MinWidth="96"
                           IsEnabled="{Binding CanSave}"
                           Click="SaveButton_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
