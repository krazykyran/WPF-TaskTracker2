<ui:FluentWindow x:Class="TaskTracker2.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:controls="clr-namespace:TaskTracker2.Views.Controls"
                 Title="TaskTracker"
                 Icon="pack://application:,,,/Assets/app.ico"
                 Width="1280"
                 Height="780"
                 MinWidth="900"
                 MinHeight="560"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 ExtendsContentIntoTitleBar="True"
                 PreviewKeyDown="MainWindow_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Compact Fluent Title Bar -->
        <ui:TitleBar Grid.Row="0"
                     Title="TaskTracker"
                     Height="36"
                     ShowMaximize="True"
                     ShowMinimize="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app-icon.png"
                              Width="16"
                              Height="16" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- 3-Pane Master-Detail Workspace -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248" />
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="DetailPaneColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <controls:SidebarView Grid.Column="0" />

            <controls:TaskListView x:Name="TaskListControl" Grid.Column="1" />

            <!-- Draggable Resizer Handle -->
            <GridSplitter x:Name="DetailSplitter"
                          Grid.Column="2"
                          Width="6"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          ShowsPreview="False"
                          Cursor="SizeWE"
                          ToolTip="Drag to resize details pane"
                          DragCompleted="DetailSplitter_DragCompleted"
                          Visibility="{Binding IsDetailPaneOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border x:Name="SplitterTrack"
                                Background="Transparent"
                                Cursor="SizeWE">
                            <Border x:Name="GripPill"
                                    Width="2"
                                    Height="44"
                                    CornerRadius="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource CardStrokeColorDefaultBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SplitterTrack" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter TargetName="GripPill" Property="Width" Value="3" />
                                <Setter TargetName="GripPill" Property="Height" Value="64" />
                                <Setter TargetName="GripPill" Property="Background" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="SplitterTrack" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter TargetName="GripPill" Property="Width" Value="3" />
                                <Setter TargetName="GripPill" Property="Height" Value="80" />
                                <Setter TargetName="GripPill" Property="Background" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <controls:TaskDetailPane Grid.Column="3"
                                     Visibility="{Binding IsDetailPaneOpen, Converter={StaticResource BoolToVisibilityConverter}}" />

            <!-- Floating Toast / Undo Snackbar Overlay -->
            <Border x:Name="ToastBanner"
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,22"
                    Padding="14,10"
                    CornerRadius="10"
                    Visibility="Collapsed"
                    Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="22" ShadowDepth="6" Opacity="0.28" Color="Black" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon x:Name="ToastIcon"
                                   Symbol="Delete20"
                                   FontSize="16"
                                   Margin="0,0,10,0"
                                   Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                    <TextBlock x:Name="ToastMessageText"
                               FontSize="13"
                               VerticalAlignment="Center"
                               MaxWidth="340"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <ui:Button x:Name="ToastUndoButton"
                               Content="Undo"
                               Appearance="Primary"
                               Padding="12,4"
                               Margin="14,0,0,0"
                               FontSize="12.5"
                               Click="ToastUndoButton_Click" />
                    <ui:Button Appearance="Transparent"
                               Padding="5"
                               Margin="6,0,0,0"
                               ToolTip="Dismiss"
                               Click="ToastDismissButton_Click">
                        <ui:SymbolIcon Symbol="Dismiss16" FontSize="12" />
                    </ui:Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
